# Copy to .env (git-ignored). Everything is optional except where noted.

# /ask needs a Gemini key; without it the API serves /search and /health only.
GEMINI_API_KEY=
# CODEXA_LLM_MODEL=gemini-3.1-flash-lite
# Optional: require this key in an X-API-Key header on /ask.
# CODEXA_ASK_KEY=

# Langfuse tracing for /ask and the eval script. Leave empty to run without tracing.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Where the packs and the model live (these are the defaults).
# CODEXA_DATA_DIR=data
# CODEXA_MODEL_DIR=models/embeddinggemma-300m-ONNX
# CODEXA_PACKS=kjv,bbe,sblgnt,wlc
